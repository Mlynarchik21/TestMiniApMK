# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tradebot"

# Telegram Bot
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
BOT_TOKEN="${TELEGRAM_BOT_TOKEN}"

# Authentication
SESSION_TTL_DAYS=30

# API Security
CRON_SECRET="your-long-random-secret-at-least-32-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DEV_AUTH_SECRET="dev-secret-at-least-32-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Cryptography
SECRET_BOX_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional: Open Endpoints (by default all are protected by auth)
# Set to "true" only if you need to expose monitoring endpoints
# ENABLE_OPEN_DIAG_ENDPOINT=false
# ENABLE_OPEN_HEALTH_ENDPOINT=false
# ENABLE_TEST_ENDPOINTS=false

# Optional: Gate/Subscribe Check
CHANNEL_ID="@channel_name"
CHANNEL_JOIN_URL="https://t.me/channel_name"

# Node Environment
NODE_ENV="production"
