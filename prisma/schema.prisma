enum BotRunStatus {
  IDLE
  RUNNING
  STOPPED
  ERROR
}

enum BotPositionStatus {
  OPEN
  CLOSING
  CLOSED
  ERROR
}

enum BotCloseReason {
  TP
  MANUAL
  STOP
  OTHER
}

enum BotOrderKind {
  ENTRY
  GRID
  TP
}

enum BotOrderStatus {
  NEW
  PLACED
  PARTIALLY_FILLED
  FILLED
  CANCELED
  ERROR
}

enum CooldownReason {
  TP_CLOSED
  MANUAL
  OTHER
}

enum EngineCycleStatus {
  STARTED
  SUCCESS
  SKIPPED
  ERROR
}

model BotConfig {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange         Exchange  @default(BINANCE)

  keyId            String?
  key              UserKey?  @relation(fields: [keyId], references: [id], onDelete: SetNull)

  enabled          Boolean   @default(false)

  maxActiveSymbols Int       @default(10)
  budgetPerSymbol  Decimal   @default(0) @db.Decimal(38, 18)
  maxTotalBudget   Decimal?  @db.Decimal(38, 18)

  syncIntervalMin  Int       @default(5)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, exchange])
  @@index([keyId])
}

model BotState {
  id         String       @id @default(cuid())
  userId     String       @unique
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     BotRunStatus @default(IDLE)
  lastSyncAt DateTime?
  lastError  String?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
}

model BotPosition {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange      Exchange
  symbol        String            @db.VarChar(32)
  status        BotPositionStatus @default(OPEN)

  avgPrice      Decimal           @db.Decimal(38, 18)
  qty           Decimal           @db.Decimal(38, 18)
  tpPrice       Decimal           @db.Decimal(38, 18)
  addsCount     Int               @default(0)
  investedQuote Decimal           @default(0) @db.Decimal(38, 18)

  openedAt      DateTime          @default(now())
  closedAt      DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  trades        BotTrade[]
  orders        BotOrder[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, exchange])
  @@index([userId, symbol])
  @@index([userId, exchange, symbol, status])
}

model BotTrade {
  id             String          @id @default(cuid())

  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  botPositionId  String?
  botPosition    BotPosition?    @relation(fields: [botPositionId], references: [id], onDelete: SetNull)

  exchange       Exchange
  symbol         String          @db.VarChar(32)

  entryValue     Decimal         @db.Decimal(38, 18)
  exitValue      Decimal         @db.Decimal(38, 18)

  qty            Decimal         @db.Decimal(38, 18)
  avgEntryPrice  Decimal         @db.Decimal(38, 18)
  exitPrice      Decimal         @db.Decimal(38, 18)

  pnl            Decimal         @db.Decimal(38, 18)
  pnlPercent     Decimal         @db.Decimal(38, 18)

  addsCount      Int             @default(0)
  closeReason    BotCloseReason  @default(TP)

  openedAt       DateTime
  closedAt       DateTime

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, closedAt])
  @@index([userId, symbol, closedAt])
  @@index([userId, exchange, closedAt])
}

model BotOrder {
  id              String         @id @default(cuid())

  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  botPositionId   String?
  botPosition     BotPosition?   @relation(fields: [botPositionId], references: [id], onDelete: SetNull)

  exchange        Exchange
  symbol          String         @db.VarChar(32)

  kind            BotOrderKind
  side            TradeSide
  status          BotOrderStatus

  price           Decimal?       @db.Decimal(38, 18)
  qty             Decimal        @db.Decimal(38, 18)

  exchangeOrderId String?
  clientOrderId   String?

  meta            Json?
  placedAt        DateTime?
  filledAt        DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([userId, exchange, createdAt])
  @@index([botPositionId])
  @@index([symbol])
  @@index([status])
}

model CooldownSymbol {
  id            String         @id @default(cuid())

  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange      Exchange
  symbol        String         @db.VarChar(32)
  reason        CooldownReason
  cooldownUntil DateTime

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, exchange, symbol])
  @@index([userId])
  @@index([cooldownUntil])
}

model EngineCycle {
  id         String            @id @default(cuid())

  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange   Exchange
  status     EngineCycleStatus @default(STARTED)
  message    String?
  meta       Json?

  startedAt  DateTime          @default(now())
  finishedAt DateTime?

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@index([userId, exchange, createdAt])
  @@index([status])
}