generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  tgId      BigInt   @unique
  username  String?
  firstName String?
  lastName  String?

  sessions  Session[]
  settings  UserSettings?
  keys      UserKey[]

  trades       Trade[]
  tradeEvents  TradeEvent[]

  botConfig    BotConfig?
  botState     BotState?
  botPositions BotPosition[]
  botTrades    BotTrade[]
  botOrders    BotOrder[]
  cooldowns    CooldownSymbol[]
  engineCycles EngineCycle[]

  notifications Notification[]
  supportMsgs   SupportMessage[]
  subscription  Subscription?
  payments      Payment[]

  referralCode  String?  @unique
  referredById  String?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]   @relation("Referrals")

  lessonProgress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  timezone String @default("UTC")
  currency String @default("USD")
  riskMode String @default("normal")

  theme              String  @default("dark")
  notifyTradeOpen    Boolean @default(true)
  notifyTradeClose   Boolean @default(true)
  notifyBotStop      Boolean @default(true)
  notifyBotError     Boolean @default(true)
  notifySubscription Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String @default("SYSTEM")
  title String
  body  String

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

model SupportMessage {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  text     String  @db.Text
  fromUser Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan         String    @default("free")
  status       String    @default("active")
  expiresAt    DateTime?
  vipExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan             String
  stars            Int
  telegramChargeId String   @unique
  status           String   @default("completed")
  payload          String?

  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

enum Exchange {
  BINANCE
  BYBIT
  OKX
}

model UserKey {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange      Exchange
  label         String?

  apiKey        String
  secretEnc     String
  passphraseEnc String?

  botConfigs    BotConfig[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@unique([userId, exchange, label])
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  CANCELED
}

enum TradeEventType {
  MANUAL_CREATE
  MANUAL_UPDATE
  MANUAL_DELETE
  SYNC_IMPORT
  ORDER_PLACED
  ORDER_FILLED
  ORDER_CANCELED
}

model Trade {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange    Exchange
  symbol      String      @db.VarChar(32)
  side        TradeSide
  status      TradeStatus @default(OPEN)

  qty         Decimal     @db.Decimal(38, 18)
  entryPrice  Decimal?    @db.Decimal(38, 18)
  exitPrice   Decimal?    @db.Decimal(38, 18)
  realizedPnl Decimal?    @db.Decimal(38, 18)

  openedAt    DateTime    @default(now())
  closedAt    DateTime?

  events      TradeEvent[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([userId, exchange])
  @@index([userId, openedAt])
  @@index([userId, status])
}

model TradeEvent {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange  Exchange
  type      TradeEventType

  tradeId   String?
  trade     Trade?         @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  payload   Json
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([userId, exchange, createdAt])
  @@index([tradeId])
}

enum BotRunStatus {
  IDLE
  RUNNING
  STOPPED
  ERROR
}

enum BotPositionStatus {
  OPEN
  CLOSING
  CLOSED
  ERROR
}

enum BotOrderKind {
  ENTRY
  GRID
  TP
}

enum BotOrderStatus {
  NEW
  PLACED
  PARTIALLY_FILLED
  FILLED
  CANCELED
  ERROR
}

enum CooldownReason {
  TP_CLOSED
  MANUAL
  OTHER
}

enum EngineCycleStatus {
  STARTED
  SUCCESS
  SKIPPED
  ERROR
}

model BotConfig {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange         Exchange  @default(BINANCE)

  keyId            String?
  key              UserKey?  @relation(fields: [keyId], references: [id], onDelete: SetNull)

  enabled          Boolean   @default(false)

  maxActiveSymbols Int       @default(10)
  budgetPerSymbol  Decimal   @default(0) @db.Decimal(38, 18)
  maxTotalBudget   Decimal?  @db.Decimal(38, 18)

  syncIntervalMin  Int       @default(5)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, exchange])
  @@index([keyId])
}

model BotState {
  id         String       @id @default(cuid())
  userId     String       @unique
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     BotRunStatus @default(IDLE)
  lastSyncAt DateTime?
  lastError  String?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
}

model BotPosition {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange      Exchange
  symbol        String            @db.VarChar(32)
  status        BotPositionStatus @default(OPEN)

  avgPrice      Decimal           @db.Decimal(38, 18)
  qty           Decimal           @db.Decimal(38, 18)
  tpPrice       Decimal           @db.Decimal(38, 18)
  addsCount     Int               @default(0)
  investedQuote Decimal           @default(0) @db.Decimal(38, 18)

  openedAt      DateTime          @default(now())
  closedAt      DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  trades        BotTrade[]
  orders        BotOrder[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, exchange])
  @@index([userId, symbol])
  @@index([userId, exchange, symbol, status])
}

model BotTrade {
  id             String       @id @default(cuid())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  botPositionId  String?
  botPosition    BotPosition? @relation(fields: [botPositionId], references: [id], onDelete: SetNull)

  exchange       Exchange
  symbol         String       @db.VarChar(32)

  entryValue     Decimal      @db.Decimal(38, 18)
  exitValue      Decimal      @db.Decimal(38, 18)

  qty            Decimal      @db.Decimal(38, 18)
  avgEntryPrice  Decimal      @db.Decimal(38, 18)
  exitPrice      Decimal      @db.Decimal(38, 18)

  pnl            Decimal      @db.Decimal(38, 18)
  pnlPercent     Decimal      @db.Decimal(38, 18)

  addsCount      Int          @default(0)

  openedAt       DateTime
  closedAt       DateTime

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, closedAt])
  @@index([userId, symbol, closedAt])
  @@index([userId, exchange, closedAt])
}

model BotOrder {
  id              String         @id @default(cuid())

  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  botPositionId   String?
  botPosition     BotPosition?   @relation(fields: [botPositionId], references: [id], onDelete: SetNull)

  exchange        Exchange
  symbol          String         @db.VarChar(32)

  kind            BotOrderKind
  side            TradeSide
  status          BotOrderStatus

  price           Decimal?       @db.Decimal(38, 18)
  qty             Decimal        @db.Decimal(38, 18)

  exchangeOrderId String?
  clientOrderId   String?

  meta            Json?
  placedAt        DateTime?
  filledAt        DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([userId, exchange, createdAt])
  @@index([botPositionId])
  @@index([symbol])
  @@index([status])
}

model CooldownSymbol {
  id            String         @id @default(cuid())

  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange      Exchange
  symbol        String         @db.VarChar(32)
  reason        CooldownReason
  cooldownUntil DateTime

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, exchange, symbol])
  @@index([userId])
  @@index([cooldownUntil])
}

model EngineCycle {
  id         String            @id @default(cuid())

  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange   Exchange
  status     EngineCycleStatus @default(STARTED)
  message    String?
  meta       Json?

  startedAt  DateTime          @default(now())
  finishedAt DateTime?

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@index([userId, exchange, createdAt])
  @@index([status])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  order       Int      @default(0)
  published   Boolean  @default(true)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  moduleTitle String?
  order       Int      @default(0)
  slides      Json     @default("[]")
  questions   Question[]
  progress    LessonProgress[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([courseId, order])
}

model Question {
  id       String  @id @default(cuid())
  lessonId String
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  text     String  @db.Text
  options  Json    @default("[]")
  answer   String
  order    Int     @default(0)

  @@index([lessonId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passed      Boolean  @default(true)
  score       Int      @default(0)
  total       Int      @default(0)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}